PORT=4100
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/stockfolio-insights
FINNHUB_API_KEY=your_finnhub_key
ANTHROPIC_API_KEY=your_anthropic_key
# SEC requires a descriptive User-Agent with contact info
SEC_USER_AGENT=StockfolioInsights yourname@email.com
WATCHLIST=AAPL,MSFT,NVDA,TSLA
INGEST_CRON=*/20 * * * *
CALENDAR_CRON=0 6 * * *
# Optional: FINRA Query API (free registration at developer.finra.org) for short interest
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

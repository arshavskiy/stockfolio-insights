PORT=4100
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/stockfolio-insights
FINNHUB_API_KEY=your_finnhub_key
OPENAI_API_KEY=your_openai_key
# SEC requires a descriptive User-Agent with contact info
SEC_USER_AGENT=StockfolioInsights yourname@email.com
WATCHLIST=AAPL,MSFT,NVDA,TSLA
INGEST_CRON=*/20 * * * *
CALENDAR_CRON=0 6 * * *
# Optional: FINRA Query API (free registration at developer.finra.org) for short interest
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
# Watchlist: synced from Stockfolio positions + watchlists (same Atlas cluster)
STOCKFOLIO_DB_NAME=stockfolio
POSITIONS_COLLECTION=positions
POSITIONS_TICKER_FIELD=ticker
WATCHLISTS_COLLECTION=watchlists
DISCOVERY_MIN_MENTIONS=5
WATCHLIST_DECAY_DAYS=30
WATCHLIST_MAX=150
# Quote poller
QUOTES_CRON=*/5 * * * *
QUOTE_STALE_SECONDS=600

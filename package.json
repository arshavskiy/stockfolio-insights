{
  "name": "stockfolio-insights",
  "version": "0.1.0",
  "description": "News-driven market insights service for Stockfolio — ingestion, ticker/industry tagging, sentiment aggregation",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "worker": "node --env-file-if-exists=.env src/workers/ingest.js",
    "worker:israeli-news": "node --env-file-if-exists=.env scripts/fetch-israeli-news.js",
    "worker:calendar": "node --env-file-if-exists=.env src/workers/calendar.js",
    "worker:quotes": "node --env-file-if-exists=.env src/workers/quotes.js",
    "backfill:ta-analyst": "node --env-file-if-exists=.env scripts/backfill-ta-analyst-consensus.js",
    "worker:all": "concurrently -n ingest,calendar,quotes -c blue,magenta,green \"npm:worker\" \"npm:worker:calendar\" \"npm:worker:quotes\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "engines": {
    "node": "20.x"
  }
}

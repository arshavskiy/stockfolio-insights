{
  "name": "stockfolio-insights",
  "version": "0.1.0",
  "description": "News-driven market insights service for Stockfolio — ingestion, ticker/industry tagging, sentiment aggregation",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/workers/ingest.js",
    "worker:israeli-news": "node src/workers/israeliNews.js",
    "worker:calendar": "node src/workers/calendar.js",
    "worker:tase-calendar": "node src/workers/taseCalendar.js",
    "worker:quotes": "node src/workers/quotes.js",
    "backfill:ta-analyst": "node scripts/backfill-ta-analyst-consensus.js",
    "backfill:israeli-news": "node scripts/fetch-israeli-news.js",
    "worker:all": "concurrently -n ingest,calendar,tase-calendar,quotes,israeli-news -c blue,magenta,cyan,green,yellow \"npm:worker\" \"npm:worker:calendar\" \"npm:worker:tase-calendar\" \"npm:worker:quotes\" \"npm:worker:israeli-news\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "engines": {
    "node": "20.x"
  }
}
